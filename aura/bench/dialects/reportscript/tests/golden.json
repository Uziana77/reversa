[
  {"name": "three record quarter", "harness": "corpus/sales.rpt",
   "input": {"RECORDS": [{"amount": 250, "qty": 20, "rep": "ANA", "region": "NORTH"}, {"amount": 80, "qty": 5, "rep": "BOB", "region": "SOUTH"}, {"amount": 120, "qty": 12, "rep": "ANA", "region": "EAST"}]},
   "expect": {"TOTAL-AMT": 450, "NET-TOTAL": 413, "HIGH-COUNT": 2, "REGION-NORTH": 250, "REGION-SOUTH": 200, "TOP-AMT": 250}},
  {"name": "discount single record", "harness": "corpus/sales.rpt",
   "input": {"RECORDS": [{"amount": 100, "qty": 20, "rep": "ANA", "region": "NORTH"}]},
   "expect": {"NET-TOTAL": 90, "COMM-TOTAL": 4.5}},
  {"name": "no discount small qty", "harness": "corpus/sales.rpt",
   "input": {"RECORDS": [{"amount": 100, "qty": 5, "rep": "BOB", "region": "SOUTH"}]},
   "expect": {"NET-TOTAL": 100, "COMM-TOTAL": 3}},
  {"name": "empty records", "harness": "corpus/sales.rpt",
   "input": {"RECORDS": []},
   "expect": {"TOTAL-AMT": 0, "HIGH-COUNT": 0, "TOP-AMT": 0}},
  {"name": "running max order independent", "harness": "corpus/sales.rpt",
   "input": {"RECORDS": [{"amount": 30, "qty": 1, "rep": "BOB", "region": "NORTH"}, {"amount": 250, "qty": 1, "rep": "BOB", "region": "NORTH"}, {"amount": 40, "qty": 1, "rep": "BOB", "region": "NORTH"}]},
   "expect": {"TOP-AMT": 250}},
  {"name": "east falls in south bucket", "harness": "corpus/sales.rpt",
   "input": {"RECORDS": [{"amount": 50, "qty": 1, "rep": "BOB", "region": "EAST"}]},
   "expect": {"REGION-SOUTH": 50, "REGION-NORTH": 0}},
  {"name": "returns totals", "harness": "corpus/returns.rpt",
   "input": {"RETURNS": [{"amount": 40}, {"amount": 30}], "GROSS": 100},
   "expect": {"RETURN-TOTAL": 70, "RETURN-COUNT": 2, "REFUND-TOTAL": 70}},
  {"name": "refund clamped", "harness": "corpus/returns.rpt",
   "input": {"RETURNS": [{"amount": 150}], "GROSS": 100},
   "expect": {"REFUND-TOTAL": 100, "FLAG-COUNT": 1}},
  {"name": "refund full below gross", "harness": "corpus/returns.rpt",
   "input": {"RETURNS": [{"amount": 50}], "GROSS": 100},
   "expect": {"REFUND-TOTAL": 50, "FLAG-COUNT": 0}},
  {"name": "empty returns", "harness": "corpus/returns.rpt",
   "input": {"RETURNS": [], "GROSS": 100},
   "expect": {"RETURN-TOTAL": 0, "RETURN-COUNT": 0, "REFUND-TOTAL": 0}}
]
