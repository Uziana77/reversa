# QUARTERLY SALES REPORT (batch job RPT-114)
# Reads the RECORDS collection (amount, qty, rep, region) and produces
# the consolidated sales report lines.

DEFINE TOTAL-AMT AS NUMBER = 0.
DEFINE NET-TOTAL AS NUMBER = 0.
DEFINE COMM-TOTAL AS NUMBER = 0.
DEFINE HIGH-COUNT AS NUMBER = 0.
DEFINE REGION-NORTH AS NUMBER = 0.
DEFINE REGION-SOUTH AS NUMBER = 0.
DEFINE TOP-AMT AS NUMBER = 0.

FOR EACH REC IN RECORDS DO
    ACCUMULATE REC_AMOUNT INTO TOTAL-AMT.
    IF REC_REGION = 'NORTH' THEN
        ACCUMULATE REC_AMOUNT INTO REGION-NORTH.
    ELSE
        ACCUMULATE REC_AMOUNT INTO REGION-SOUTH.
    END-IF.
    IF REC_AMOUNT > 100 THEN
        LET HIGH-COUNT = HIGH-COUNT + 1.
        PRINT 'HIGH' REC_REP REC_AMOUNT.
    END-IF.
    IF REC_QTY > 10 THEN
        LET DISCOUNT = REC_AMOUNT * 0.9.
    ELSE
        LET DISCOUNT = REC_AMOUNT.
    END-IF.
    ACCUMULATE DISCOUNT INTO NET-TOTAL.
    IF REC_REP = 'ANA' THEN
        LET COMM = DISCOUNT * 0.05.
    ELSE
        LET COMM = DISCOUNT * 0.03.
    END-IF.
    ACCUMULATE COMM INTO COMM-TOTAL.
    IF REC_AMOUNT > TOP-AMT THEN
        LET TOP-AMT = REC_AMOUNT.
    END-IF.
END-FOR.

PRINT 'TOTAL' TOTAL-AMT.
PRINT 'NET' NET-TOTAL.
PRINT 'COMM' COMM-TOTAL.
PRINT 'HIGH' HIGH-COUNT.
PRINT 'TOP' TOP-AMT.
