# RETURNS RECONCILIATION (batch job RPT-208)
# Companion report: reconciles returns against the gross amount.

DEFINE RETURN-TOTAL AS NUMBER = 0.
DEFINE RETURN-COUNT AS NUMBER = 0.
DEFINE REFUND-TOTAL AS NUMBER = 0.
DEFINE FLAG-COUNT AS NUMBER = 0.

FOR EACH RET IN RETURNS DO
    ACCUMULATE RET_AMOUNT INTO RETURN-TOTAL.
    LET RETURN-COUNT = RETURN-COUNT + 1.
    IF RET_AMOUNT > GROSS THEN
        LET REFUND = GROSS.
        LET FLAG-COUNT = FLAG-COUNT + 1.
        PRINT 'CLAMPED' RET_AMOUNT.
    ELSE
        LET REFUND = RET_AMOUNT.
    END-IF.
    ACCUMULATE REFUND INTO REFUND-TOTAL.
END-FOR.

PRINT 'RETURNS' RETURN-COUNT.
PRINT 'REFUND' REFUND-TOTAL.
