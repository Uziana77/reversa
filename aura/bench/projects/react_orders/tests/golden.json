[
  {"name": "simple order", "harness": "orderMath.js",
   "input": {"lines": [{"price": 1000, "qty": 2}], "promo": "", "country": "US"},
   "expect": {"subtotal": 2000, "discount": 0, "shipping": 500, "total": 2500, "status": "OPEN"}},
  {"name": "quantity break", "harness": "orderMath.js",
   "input": {"lines": [{"price": 1000, "qty": 12}], "promo": "", "country": "US"},
   "expect": {"subtotal": 10800, "total": 11300}},
  {"name": "multi line order", "harness": "orderMath.js",
   "input": {"lines": [{"price": 500, "qty": 3}, {"price": 2000, "qty": 1}], "promo": "", "country": "US"},
   "expect": {"subtotal": 3500, "total": 4000}},
  {"name": "save10 applied", "harness": "orderMath.js",
   "input": {"lines": [{"price": 1000, "qty": 6}], "promo": "SAVE10", "country": "US"},
   "expect": {"subtotal": 6000, "discount": 600, "total": 5900}},
  {"name": "save20 applied", "harness": "orderMath.js",
   "input": {"lines": [{"price": 1000, "qty": 20}], "promo": "SAVE20", "country": "CA"},
   "expect": {"subtotal": 18000, "discount": 3600, "shipping": 1200, "total": 15600}},
  {"name": "review threshold", "harness": "orderMath.js",
   "input": {"lines": [{"price": 25000, "qty": 1}], "promo": "", "country": "US"},
   "expect": {"total": 25500, "status": "REVIEW"}},
  {"name": "international hold", "harness": "orderMath.js",
   "input": {"lines": [{"price": 30000, "qty": 1}], "promo": "", "country": "DE"},
   "expect": {"subtotal": 30000, "shipping": 2500, "status": "HOLD"}},
  {"name": "empty order", "harness": "orderMath.js",
   "input": {"lines": [], "promo": "SAVE10", "country": "US"},
   "expect": {"subtotal": 0, "discount": 0, "total": 500, "status": "OPEN"}},
  {"name": "promo below threshold", "harness": "orderMath.js",
   "input": {"lines": [{"price": 1000, "qty": 4}], "promo": "SAVE10", "country": "US"},
   "expect": {"subtotal": 4000, "discount": 0, "total": 4500}}
]
