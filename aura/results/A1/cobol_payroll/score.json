      "statement": "Gross pay is the sum of base pay, overtime, shift premium and bonus."
    },
    {
      "gold": "PAY-R11",
      "statement": "Gross pay up to 1000 is taxed at 5 percent."
    },
    {
      "gold": "PAY-R12",
      "statement": "Gross pay from 1001 to 3000 is taxed at 10 percent."
    },
    {
      "gold": "PAY-R13",
      "statement": "Gross pay above 3000 is taxed at 15 percent."
    },
    {
      "gold": "PAY-R14",
      "statement": "Each absent day penalises the payslip by 20."
    },
    {
      "gold": "PAY-R15",
      "statement": "Net pay equals gross pay minus tax and absence penalty."
    },
    {
      "gold": "PAY-R16",
      "statement": "PAY-STATUS is P when net pay is positive and Z otherwise."
    },
    {
      "gold": "PAY-R17",
