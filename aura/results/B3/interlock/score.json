      "statement": "The rotor interlock blocks rotation while the access door is open."
    },
    {
      "gold": "ILG-R16",
      "statement": "The door assert raises the door-open alarm while the access door is open."
    },
    {
      "gold": "ILG-R17",
      "statement": "The door assert stays silent while the access door is closed."
    },
    {
      "gold": "ILG-R18",
      "statement": "On night shift the horn annunciates whenever the relief valve opens."
    },
    {
      "gold": "ILG-R19",
      "statement": "On day shift the relief valve opens without sounding the horn."
    },
    {
      "gold": "ILG-R20",
      "statement": "The vent permissive opens when the manual vent is open and pressure is above 150 kPa."
    },
    {
      "gold": "ILG-R21",
      "statement": "The vent permissive stays closed while the manual vent handle is shut."
    },
    {
      "gold": "ILG-R22",
      "statement": "A fan cut revokes an already-granted start permissive (the cut-start interlock)."
    },
    {
      "gold": "ILG-R23",
      "statement": "In AUTO mode cooling is forced on once the flue gas exceeds 85 Celsius."
    },
    {
      "gold": "ILG-R24",
      "statement": "The annunciator lights whenever the horn or the vent permissive is active."
    },
    {
      "gold": "ILG-R25",
